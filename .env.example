# Хуваалцах холбоос болон og:image-д хэрэглэгдэх бүтэн хаяг.
# Vercel дээр автоматаар тодорхойлогддог тул зөвхөн локал/өөр хостод хэрэгтэй.
NEXT_PUBLIC_SITE_URL=

# Admin (/admin) дээр хийсэн засвар (асуулт, 2 дахь асуулт) БҮХ зочинд
# харагдахын тулд энд хадгална. Тавиагүй үед процессын доторх санах ойд
# хадгална — dev сервер дахин асаахад анхны утга руу буцна.
#
# Vercel дээр: Storage → Create Database → Upstash for Redis холбоход эдгээр
# хоёр автоматаар нэмэгддэг.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
